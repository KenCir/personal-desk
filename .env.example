DATABASE_URL=postgres://personal_desk:personal_desk@localhost:5432/personal_desk
POSTGRES_PASSWORD=personal_desk
POSTGRES_PORT=5432
DATA_SOURCE=mock

# Notion internal connection: Read content only; share Areas/Projects/Tasks explicitly.
NOTION_TOKEN=
NOTION_AREAS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_TASKS_DATA_SOURCE_ID=
# Optional explicit property/status mapping JSON path, relative to the workspace root.
NOTION_MAPPING_FILE=
# Required for writes; copy the verified host:port/database from --check-db.
NOTION_SYNC_TARGET=
# Worker writes are opt-in. No service is installed by these settings.
NOTION_WORKER_ENABLED=false
NOTION_POLL_INTERVAL_MS=300000
NOTION_FULL_INTERVAL_MS=21600000
