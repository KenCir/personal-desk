{
  "name": "personal-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @personal-desk/web dev",
    "build": "pnpm --filter @personal-desk/web build",
    "start": "pnpm --filter @personal-desk/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:database": "playwright test --config playwright.database.config.ts",
    "format": "prettier --write apps packages tests *.json *.ts *.mjs *.yaml README.md IMPLEMENTATION.md",
    "format:check": "prettier --check apps packages tests *.json *.ts *.mjs *.yaml README.md IMPLEMENTATION.md",
    "db:generate": "pnpm --filter @personal-desk/database generate",
    "db:migrate": "pnpm --filter @personal-desk/database migrate",
    "db:smoke": "pnpm --filter @personal-desk/database smoke",
    "notion:sync": "pnpm --filter @personal-desk/integrations notion"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
