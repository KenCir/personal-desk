{
  "name": "personal-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @personal-desk/web dev",
    "build": "pnpm --filter @personal-desk/web build",
    "start": "pnpm --filter @personal-desk/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/ci/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:database": "playwright test --config playwright.database.config.ts",
    "format": "prettier --write apps packages tests scripts/docker scripts/ci *.json *.ts *.mjs *.yaml README.md IMPLEMENTATION.md && prettier --ignore-path .prettierignore-operations --write docs/operations .github/workflows/ci.yml",
    "format:check": "prettier --check apps packages tests scripts/docker scripts/ci *.json *.ts *.mjs *.yaml README.md IMPLEMENTATION.md && prettier --ignore-path .prettierignore-operations --check docs/operations .github/workflows/ci.yml",
    "test:docker": "node scripts/ci/docker.mjs",
    "db:generate": "pnpm --filter @personal-desk/database generate",
    "db:migrate": "pnpm --filter @personal-desk/database migrate",
    "db:smoke": "pnpm --filter @personal-desk/database smoke",
    "notion:sync": "pnpm --filter @personal-desk/integrations notion",
    "notion:worker": "pnpm --filter @personal-desk/worker start"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
